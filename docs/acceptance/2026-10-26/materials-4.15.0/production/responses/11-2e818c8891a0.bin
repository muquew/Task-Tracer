  "help": {
    "menu": "Help and support",
    "intro": "Task Tracer {version} · Your tasks stay in this browser profile. Start with a task, then organize it as needed.",
    "captureTitle": "Capture and plan",
    "captureBody": "Choose Add task in the top bar to open the full form and continue any unfinished draft. Use the arrow beside it to open Quick capture. Separate a date, time, #tag and /project with spaces, for example: tomorrow 14:00 Discuss the plan #work /Project. Check the preview before adding. Open Full form to continue editing a description, subtasks, reminders or recurrence. Use a task’s Task actions menu to add it to today’s plan; you can also add tasks in bulk.",
    "findTitle": "Find your work",
    "findBody": "Use the left navigation for List, Calendar, Timeline and Stats, or the bottom navigation on mobile. Search supports project:work, tag:study, status:completed, due:today and #tag; combine terms to narrow the results. Save view keeps searches, filters and layouts you use often. Clear the conditions directly when no tasks match.",
    "backupTitle": "Protect and move tasks",
    "backupBody": "Use Backups & transfer in Settings & data to download a backup or choose a backup file. JSON backups contain all tasks and can restore them on another browser or device. They exclude saved views, preferences and recovery history. CSV is for reports only. Recovery history shares browser storage with your tasks; keep a separate backup before clearing site data or moving devices. Transfer saved views in their separate file.",
    "offlineTitle": "Offline use and reminders",
    "offlineBody": "Open the app online and let it finish caching before using it offline. Use Settings & data to install the app or find your browser’s installation steps. Enable notifications there too. If permission is blocked, first allow notifications in your browser’s site settings. Reminders depend on the browser, operating system and app lifecycle; they are not guaranteed alarms when the app is closed.",
    "privacyTitle": "Support and privacy",
    "privacyBody": "Reports open on GitHub, outside this app. Use synthetic tasks and review any files or screenshots before posting. Never attach your personal task backup to a public issue. For security vulnerabilities, follow SECURITY.md in the repository. Text captured through URL links may appear in browser history or hosting request logs.",
    "shortcuts": "Keyboard shortcuts",
    "newTask": "New task",
    "search": "Focus search",
    "commands": "Open command palette",
    "undo": "Undo outside text fields",
    "close": "Close",
    "diagnostics": "Review diagnostic information",
    "diagnosticEntryDescription": "Preview a report before downloading. Nothing is sent automatically.",
    "diagnosticDescription": "Review this report before downloading or sharing it. It contains app and browser versions, capabilities and storage status. It excludes task contents, saved views, preferences, page URLs and error messages. Nothing is sent automatically.",
    "downloadDiagnostics": "Download report",
    "diagnosticError": "Could not prepare the diagnostic report. Try again.",
    "support": "Report an issue on GitHub",
    "datesTitle": "Dates and clock changes",
    "datesBody": "Separate dates, times, #tags and /projects with spaces. Chinese weekday shorthand such as 周三 uses the nearest occurrence, including today; 本周三 uses the Monday-based current week, even when the date is past, and 下周三 uses the following week. A month/day without a year uses the nearest valid date on or after today; February 29 skips non-leap years. Today/tomorrow use the local date when submitted. Existing deadlines keep their task time zone after a device-zone change. Times skipped by a clock change move forward; repeated times use the first occurrence. Editing other fields preserves the saved instant. Repeating tasks advance from the previous saved local date and time.",
    "settings": "Open Settings & data",
    "appearanceBody": "Use Appearance & language in Settings & data for Light, Dark, System, Chinese and English. Changing the interface language does not rewrite your tasks, projects or tags.",
    "quickStartDescription": "Find the task you need, then open more detail if needed."
  },
