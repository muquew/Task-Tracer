+                      pressed:button?.getAttribute('aria-pressed') === 'true',
+                      enabled:button?.classList.contains('notifications-enabled') === true,
+                      label_disable:typeof labels.disable === 'string' && button?.getAttribute('aria-label') === labels.disable,
