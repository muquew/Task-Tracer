+def prepare_invalid_schedule_draft(page: Page, name: str) -> None:
+    fill_schedule(page, name, 'custom')
+    reveal_task_field(page, '#repeatInterval').fill('5')
+    page.locator('#subtaskListPreview .subtask-preview-text').first.click()
