+def assert_editor_input_error(page: Page, evidence: Path, field: str, error: str,
+                              values, before) -> None:
+    expect(page.locator('#taskModal')).to_be_visible()
+    expect(page.locator('#submitBtn')).to_be_enabled()
+    expect(page.locator('#taskDraftSavingStatus')).to_have_count(0)
+    expect(page.locator(field)).to_have_attribute('aria-invalid', 'true')
+    expect(page.locator(field)).to_be_focused()
+    expect(page.locator(error)).to_be_visible()
+    assert raw_form(page) == values, 'Schedule validation changed another unfinished form field'
+    assert visible_preview_draft_texts(page) == ['验证失败仍保留的行内子任务'], 'Schedule validation lost the inline child draft'
+    assert stored(page) == before, 'Invalid schedule wrote tasks, revisions or recovery configuration'
+    geometry_script = '''({field, error}) => {
+        const input = document.querySelector(field), message = document.querySelector(error);
+        const form = document.getElementById('taskForm');
+        const footer = form.querySelector('.form-actions');
+        const header = document.querySelector('#taskModal .modal-header');
+        const rect = node => { const r = node.getBoundingClientRect();
+            return {top:r.top, bottom:r.bottom, left:r.left, right:r.right, width:r.width, height:r.height}; };
+        const e=rect(message), f=rect(form), a=rect(footer), h=rect(header);
+        const clip={top:Math.max(0,f.top,h.bottom),bottom:Math.min(innerHeight,f.bottom,a.top),
+            left:Math.max(0,f.left),right:Math.min(innerWidth,f.right)};
+        const hit=document.elementFromPoint((e.left+e.right)/2,(e.top+e.bottom)/2);
+        return {field:rect(input),error:e,form:f,footer:a,header:h,clip,
+            fullyVisible:!message.hidden&&e.width>0&&e.height>0&&e.top>=clip.top-1&&e.bottom<=clip.bottom+1
+                &&e.left>=clip.left-1&&e.right<=clip.right+1,
+            hitInside:Boolean(hit&&(hit===message||message.contains(hit))),
+            hit:hit?{tag:hit.tagName,id:hit.id,className:hit.className}:null};
+    }'''
+    geometry = page.evaluate(geometry_script, {'field': field, 'error': error})
+    save_json(evidence / 'validation-visibility.json', geometry)
+    assert geometry['fullyVisible'] and geometry['hitInside'], 'Schedule error was covered or outside the visible editor'
+    page.screenshot(path=str(evidence / 'invalid-schedule-feedback.png'), full_page=True)
+    save_json(evidence / 'invalid-raw-after.json', raw_form(page))
+    save_json(evidence / 'invalid-db-after.json', stored(page))
+
+
+def assert_corrected_custom_schedule(page: Page, before, name: str, date_key: str):
+    expect(page.locator('#taskModal')).to_be_hidden()
+    task = only_added(page, before['tasks'], name,
+                      ['验证失败仍保留的行内子任务', '仍在输入框中的子任务'])
+    assert task['dueLocalDate'] == date_key and task['dueLocalTime'] == '16:35', task
+    assert task['repeatType'] == 'custom' and task['repeatInterval'] == 5, task
+    assert task['repeatPaused'] is True, task
+    assert task['reminderOffset'] == 60 and task['reminderRepeat'] == 15, task
+    assert task['description'] == '第一行原始描述。\n第二行保留。', task
+    assert task['project'] == '编辑安全审查' and task['tags'] == ['review', 'tag, with comma'], task
+    assert config(stored(page))['taskRevision'] == config(before)['taskRevision'] + 1
+    return task
