  "help": {
    "menu": "Help and support",
    "intro": "Task Tracer {version} · Your tasks stay in this browser profile. Start with a task, then organize it as needed.",
    "captureTitle": "Capture and plan",
    "captureBody": "Open Quick add and filter tools to add a task. Try: tomorrow 20:00 Review notes #study /Personal. Use the full task form for subtasks and recurrence. The target button adds a task to your daily plan. Without a year, a month/day uses the nearest valid date on or after today; February 29 skips non-leap years. Dates or times skipped by a clock change move forward using the same rules as the full form. Today/tomorrow use the local date when you submit.",
    "findTitle": "Find your work",
    "findBody": "Search supports project:work, tag:study, status:completed, due:today and #tag. Combine terms to narrow the results. Save the current search, filters and view with the bookmark button.",
    "backupTitle": "Protect and move tasks",
    "backupBody": "Export/Backup downloads JSON task data for restoration on another browser or device. It excludes saved views, app preferences and recovery history. CSV exports all tasks for spreadsheet reports and cannot restore the workspace. Recovery history shares this browser’s storage; keep a separate JSON backup before clearing site data or changing domains. Use Transfer saved views for a separate file of saved searches and layouts.",
    "offlineTitle": "Offline use and reminders",
    "offlineBody": "Open the app online once before using it offline. Install from the menu or your browser when supported. Notifications require your permission and depend on the browser, operating system and app lifecycle; they are not guaranteed alarms when the app is closed.",
    "privacyTitle": "Support and privacy",
    "privacyBody": "Reports open on GitHub, outside this app. Use synthetic tasks and review any files or screenshots before posting. Never attach your personal task backup to a public issue. For security vulnerabilities, follow SECURITY.md in the repository. Text captured through URL links may appear in browser history or hosting request logs.",
    "shortcuts": "Keyboard shortcuts",
    "newTask": "New task",
    "search": "Focus search",
    "commands": "Open command palette",
    "undo": "Undo outside text fields",
    "close": "Close",
    "diagnostics": "Review diagnostic information",
    "diagnosticDescription": "Review this report before downloading or sharing it. It contains app and browser versions, capabilities and storage status. It excludes task contents, saved views, preferences, page URLs and error messages. Nothing is sent automatically.",
    "downloadDiagnostics": "Download diagnostic report",
    "diagnosticError": "Could not prepare the diagnostic report. Try again.",
    "support": "Report an issue on GitHub",
    "datesTitle": "Dates and clock changes",
    "datesBody": "Deadlines keep their task time zone when the device zone changes. New repeated clock times use the first occurrence; nonexistent times move forward by the clock change. Editing other fields preserves an existing deadline’s exact instant. Repeating tasks advance from the last occurrence’s saved local date and time."
