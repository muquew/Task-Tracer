{
  "name": "task-tracer-quality-tools",
  "version": "5.3.0",
  "private": true,
  "description": "Development tools and checked-in static assets for the local-first Task Tracer PWA.",
  "scripts": {
    "dev": "npm run site && python3 -m http.server 8080 --bind 127.0.0.1 --directory dist/site",
    "preview": "npm run dev",
    "site": "node scripts/build-site.mjs",
    "icons": "python3 -m scripts.build_icons",
    "icons:check": "python3 -m scripts.build_icons --check",
    "test:a11y": "python3 -m tests.browser.accessibility_i18n_audit",
    "test": "python3 -m scripts.check",
    "test:report": "python3 -m scripts.check --keep-going --report dist/check-results.json",
    "test:browsers": "python3 -m scripts.browser_matrix --keep-going",
    "check": "python3 -m scripts.check --static-only",
    "build": "python3 -m scripts.build_release",
    "styles": "python3 -m scripts.build_styles",
    "styles:check": "python3 -m scripts.build_styles --check"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.5"
  }
}
