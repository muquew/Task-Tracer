{
  "name": "task-tracer-quality-tools",
  "version": "5.0.0",
  "private": true,
  "description": "Development tools and checked-in static assets for the local-first Task Tracer PWA.",
  "scripts": {
    "test:a11y": "python3 tools/accessibility_i18n_audit.py",
    "test": "python3 tools/check.py",
    "check": "python3 tools/check.py --static-only",
    "build": "python3 tools/build_release.py",
    "styles": "python3 tools/build_styles.py",
    "styles:check": "python3 tools/build_styles.py --check"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.5"
  }
}
